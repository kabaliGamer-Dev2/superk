rules_version = '2';

// SuperK feedback: public create-only, validated. Reads/writes restricted
// to the Firebase Console (project owners). Everything else denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /feedback/{doc} {
      allow create: if request.resource.data.type in ['bug', 'feature', 'download', 'praise']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.size() >= 5
        && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 24
        && request.resource.data.browser is string
        && request.resource.data.browser.size() <= 40
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 40
        && request.resource.data.extVersion is string
        && request.resource.data.extVersion.size() <= 20
        && request.resource.data.screenshot is string
        && request.resource.data.screenshot.size() <= 500
        && request.resource.data.issues is list
        && request.resource.data.issues.size() <= 10
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 300
        && request.resource.data.rating is int
        && request.resource.data.rating >= 0
        && request.resource.data.rating <= 5;
      allow read, update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
